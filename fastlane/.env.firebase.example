# Environment for Firebase App Distribution. Copy to fastlane/.env.firebase (git-ignored) or set the same
# variables in CI. scripts/distribute-firebase.sh reads it for Android (`make distribute-android`); fastlane reads it
# for iOS (`bundle exec fastlane … --env firebase`). Android needs none of it when `firebase login` is done: the app id
# comes from google-services.json, and FIREBASE_GROUPS is only a default for --groups.

# A service account JSON file with the "Firebase App Distribution Admin" role.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-app-distribution.json

# Firebase app ids (Project settings → Your apps), per platform, app and flavor.
FIREBASE_APP_ID_ANDROID_CUSTOMER_BETA=1:000000000000:android:0000000000000000000000
FIREBASE_APP_ID_ANDROID_CUSTOMER_DEV=1:000000000000:android:1111111111111111111111
FIREBASE_APP_ID_IOS_BETA=1:000000000000:ios:0000000000000000000000

# Tester groups by default (comma-separated aliases from the console).
FIREBASE_GROUPS=qa

# The ad-hoc iOS build (as for TestFlight).
IOS_BUNDLE_ID_BETA=com.example.app.beta
APP_STORE_CONNECT_API_KEY_PATH=/path/to/app-store-connect-key.json
MATCH_GIT_URL=git@github.com:your-org/certificates.git
MATCH_PASSWORD=
